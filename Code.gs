// Escapeclub — plak dit script in de gebonden Apps Script-editor van de Sheet.
// Voer setup() eenmaal handmatig uit, daarna implementeren als web-app.
const SHEET_ID = '1-7h0RlVXqfZlLBdONIKchTlnU0ZGofux-XV3wyencmQ';
const ROOM_HEADERS=['ID','Naam','Aanbieder','Locatie','Website','Bucket-ID','Spelers','Prijs totaal (€)','Duur (min)','Thema','Datum','Notities','Favoriet','Volgorde'];
function setup(){const p=PropertiesService.getScriptProperties();if(!p.getProperty('KEY'))p.setProperty('KEY',Utilities.getUuid()+Utilities.getUuid());console.log('Verbindingssleutel: '+p.getProperty('KEY'));}
function readData(){const ss=SpreadsheetApp.openById(SHEET_ID);const a=ss.getSheetByName('Escaperooms'),b=ss.getSheetByName('Buckets');if(!a||!b)throw Error('Tabblad Escaperooms of Buckets ontbreekt.');if(a.getLastRow()>1001||b.getLastRow()>31)throw Error('Maximaal 1000 kamers en 30 buckets.');const rows=a.getRange(1,1,Math.max(1,a.getLastRow()),14).getValues();if(rows[0].join('|')!==ROOM_HEADERS.join('|'))throw Error('De kolomkoppen van Escaperooms zijn gewijzigd.');const buckets=b.getRange(1,1,Math.max(1,b.getLastRow()),4).getValues().slice(1).filter(r=>r[0]).sort((x,y)=>Number(x[3])-Number(y[3])).map(r=>({id:String(r[0]),name:String(r[1]),color:String(r[2])}));const rooms=rows.slice(1).filter(r=>r[0]).sort((x,y)=>Number(x[13])-Number(y[13])).map(r=>({id:String(r[0]),name:String(r[1]),provider:String(r[2]),location:String(r[3]),website:String(r[4]),bucketId:String(r[5]),players:String(r[6]),price:r[7],duration:r[8],theme:String(r[9]),date:r[10] instanceof Date?Utilities.formatDate(r[10],ss.getSpreadsheetTimeZone(),'yyyy-MM-dd'):String(r[10]),notes:String(r[11]),favorite:r[12]===true||String(r[12]).toLowerCase()==='true'}));return {buckets,rooms};}
function revision(data){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(data)));}
function validate(d){if(!d||!Array.isArray(d.buckets)||!Array.isArray(d.rooms)||d.buckets.length<1||d.buckets.length>30||d.rooms.length>1000)throw Error('Ongeldige bordgegevens.');const ids={};d.buckets.forEach(b=>{if(typeof b.id!=='string'||!b.id||ids[b.id]||typeof b.name!=='string'||!b.name.trim()||!/^#[0-9a-f]{6}$/i.test(b.color))throw Error('Ongeldige bucket.');ids[b.id]=true});const roomIds={};d.rooms.forEach(r=>{if(typeof r.id!=='string'||!r.id||roomIds[r.id]||typeof r.name!=='string'||!r.name.trim()||!ids[r.bucketId])throw Error('Ongeldige kamer.');roomIds[r.id]=true;Object.keys(r).forEach(k=>{if(typeof r[k]==='object'||String(r[k]).length>4000)throw Error('Ongeldig veld.')})});}
function cell(v){return typeof v==='string'&&/^[=+@-]/.test(v)?"'"+v:v??'';}
function doPost(e){let lock;try{if(!e.postData||e.postData.contents.length>3000000)throw Error('Ongeldig verzoek.');const x=JSON.parse(e.postData.contents),secret=PropertiesService.getScriptProperties().getProperty('KEY');if(x.board!=='expert-escapers-public'&&(!secret||x.key!==secret))throw Error('Ongeldig verzoek.');lock=LockService.getScriptLock();lock.waitLock(20000);const current=readData();if(x.action==='load')return json({ok:true,data:current,revision:revision(current)});if(x.action!=='save')throw Error('Onbekende actie.');if(x.revision!==revision(current))throw Error('De Sheet is intussen gewijzigd. Vernieuw eerst het bord.');validate(x.data);const ss=SpreadsheetApp.openById(SHEET_ID),a=ss.getSheetByName('Escaperooms'),b=ss.getSheetByName('Buckets');const rooms=x.data.rooms.map((r,i)=>[r.id,r.name,r.provider,r.location,r.website,r.bucketId,r.players,r.price,r.duration,r.theme,r.date,r.notes,!!r.favorite,i].map(cell));const buckets=x.data.buckets.map((r,i)=>[r.id,r.name,r.color,i].map(cell));if(rooms.length+1>a.getMaxRows())a.insertRowsAfter(a.getMaxRows(),rooms.length+1-a.getMaxRows());if(buckets.length+1>b.getMaxRows())b.insertRowsAfter(b.getMaxRows(),buckets.length+1-b.getMaxRows());if(a.getLastRow()>1)a.getRange(2,1,a.getLastRow()-1,14).clearContent();if(b.getLastRow()>1)b.getRange(2,1,b.getLastRow()-1,4).clearContent();if(rooms.length){a.getRange(2,11,rooms.length,1).setNumberFormat('@');a.getRange(2,1,rooms.length,14).setValues(rooms);}b.getRange(2,1,buckets.length,4).setValues(buckets);SpreadsheetApp.flush();const saved=readData();return json({ok:true,revision:revision(saved)});}catch(err){return json({ok:false,error:String(err.message||err)});}finally{if(lock)lock.releaseLock();}}
function doGet(){return json({ok:false,error:'Gebruik de Escapeclub-site om te verbinden.'});}
function json(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
